#!/bin/sh
# Runs before every commit: formatting, then the Cora review of the staged change.
# Exit codes of `cora review --ci`: 0 pass, 2 major or critical findings (blocks), anything else is
# a tooling or network error: the commit may go on, but a real verdict is needed before pushing.
set -u
cargo fmt --all --check || { echo "pre-commit: run cargo fmt --all" >&2; exit 1; }
if ! command -v cora >/dev/null 2>&1; then
    echo "pre-commit: cora is not installed; run 'cora review --staged --ci --severity major' by hand" >&2
    exit 0
fi
cora review --staged --ci --severity major
status=$?
if [ "$status" -eq 2 ]; then
    echo "pre-commit: Cora found major or critical issues; fix them (do not use --no-verify)" >&2
    exit 1
fi
if [ "$status" -ne 0 ]; then
    echo "pre-commit: Cora did not give a verdict (exit $status); get one before pushing" >&2
fi
exit 0
