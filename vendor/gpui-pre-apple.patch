+/// The colour matrix a buffer is tagged with; BT.601 (upstream's behaviour) when untagged.
+fn surface_matrix(image_buffer: &objc2_core_video::CVPixelBuffer) -> ycbcr::Matrix {
+    // SAFETY: A null attachment-mode pointer is allowed; the result is a retained CFType.
+    let tag = unsafe { image_buffer.attachment(kCVImageBufferYCbCrMatrixKey, ptr::null_mut()) };
+    tag.and_then(|value| value.downcast::<CFString>().ok())
+        .and_then(|name| ycbcr::Matrix::from_cv_name(&name.to_string()))
+        .unwrap_or(ycbcr::DEFAULT_MATRIX)
