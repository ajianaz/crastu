
# Vendored font licence texts are verbatim upstream (they contain the OFL's own plain-HTTP link):
# keep their text out of diffs, like the binary font files.
crates/ui/crastu-ui/assets/fonts/**/OFL.txt -diff

# Generated by `cargo xtask licences` (licence texts verbatim from the crates, which contain plain-HTTP
# links, and the NOTICE built from them); `licences --check` guards them, so keep them out of diffs.
LICENSES/** -diff eol=lf
NOTICE -diff eol=lf

# Standard Apache-2.0 text used by `cargo xtask licences` for crates that ship no licence file
# (verbatim, with the licence's own plain-HTTP link): keep it out of diffs.
xtask/spdx/templates/*.txt eol=lf
xtask/spdx/templates/Apache-2.0.txt -diff eol=lf

# Vendored copy of gpui-pre-apple (docs/vendor-gpui.md): third-party source that is patched in four
# files. The change is reviewed through vendor/gpui-pre-apple.patch (outside this glob, so it stays
# diffable), so keep the whole copy out of diffs.
vendor/gpui-pre-apple/** -diff eol=lf
